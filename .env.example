# Local development uses SQLite when DATABASE_URL is not set.
DATABASE_URL=sqlite:///./voice_agent.db
LOG_LEVEL=INFO

# Railway sets PORT automatically. This is only needed for local container runs.
# PORT=8000

# Vapi assistant administration. Never commit real values.
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_TOOL_SECRET=
# VAPI_CREDENTIAL_ID=
# PUBLIC_BASE_URL=https://your-api.example.com
